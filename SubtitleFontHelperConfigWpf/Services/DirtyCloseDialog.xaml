<Window x:Class="SubtitleFontHelperConfigWpf.Services.DirtyCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认关闭"
        Width="460"
        Height="230"
        MinWidth="460"
        MinHeight="230"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="#F7F1E8"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="当前有未保存的修改，确认要关闭窗口吗？"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1F2F3F"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0"
                       Text="你可以先保存当前配置，或直接关闭窗口。"
                       FontSize="14"
                       Foreground="#5B6A79"
                       TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Right"
                   Margin="0,18,0,0">
            <Button MinWidth="108"
                    Margin="0,0,10,0"
                    Padding="16,8"
                    Background="#D48E3F"
                    BorderBrush="#D48E3F"
                    Foreground="#1D2732"
                    FontWeight="SemiBold"
                    Click="SaveAndClose">
                保存后关闭
            </Button>
            <Button MinWidth="96"
                    Margin="0,0,10,0"
                    Padding="16,8"
                    Background="#F7F0E6"
                    BorderBrush="#CFBA9F"
                    Foreground="#203142"
                    Click="CloseWithoutSaving">
                直接关闭
            </Button>
            <Button MinWidth="84"
                    Padding="16,8"
                    Background="#F7F0E6"
                    BorderBrush="#CFBA9F"
                    Foreground="#203142"
                    IsCancel="True"
                    Click="CancelClose">
                取消
            </Button>
        </WrapPanel>
    </Grid>
</Window>
